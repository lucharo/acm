{
  "name": "acm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "Agent CriticMarkup — a local single-document editor for human + AI prose collaboration over a CriticMarkup .md file.",
  "bin": {
    "acm": "./cli.ts"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun run scripts/dev.ts",
    "vite": "vite",
    "server": "bun --watch server.ts",
    "build": "vite build",
    "build:embed": "vite build && bun run scripts/gen-embedded.ts && bun run scripts/gen-embedded-dicts.ts",
    "build:bin": "bun run build:embed && bun run scripts/build-bin.ts",
    "start": "bun run server.ts",
    "preview": "bun run server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:bin": "bun run scripts/smoke-bin.ts",
    "test:e2e": "bun run scripts/e2e-browser.ts",
    "test:setup": "bun test scripts/setup.test.ts",
    "test:install": "bun test scripts/install.test.ts",
    "check": "bun run scripts/check.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@xmldom/xmldom": "^0.9.10",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "fflate": "^0.8.3",
    "katex": "0.18.4",
    "lucide-react": "^1.30.0",
    "nspell": "^2.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react-test-renderer": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
