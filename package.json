{
  "name": "acm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent CriticMarkup — a local single-document editor for human + AI prose collaboration over a CriticMarkup .md file.",
  "bin": {
    "acm": "./cli.ts"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "vite": "vite",
    "server": "bun --watch server.ts",
    "build": "vite build",
    "build:embed": "vite build && bun run scripts/gen-embedded.ts",
    "build:bin": "bun run build:embed && bun build --compile --outfile dist/acm ./cli.ts",
    "start": "bun run server.ts",
    "preview": "bun run server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/lib src/editor"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
